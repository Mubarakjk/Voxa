# Copy to .env and add your keys. Restart Expo after changing env vars.

# SECURITY: Never put production OpenAI secret keys in the client binary.
# Prefer the AI gateway for release builds.
EXPO_PUBLIC_AI_GATEWAY_URL=
# Dev-only direct OpenAI — NEVER ship a permanent sk- key in App Store / TestFlight builds.
# Production Realtime/OpenAI secrets belong in Supabase Edge Function secrets only.
EXPO_PUBLIC_OPENAI_API_KEY=

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Music recognition is hidden for release unless experimental features are enabled.
EXPO_PUBLIC_AUDD_API_TOKEN=

# Beta / experimental: keep false for App Store builds
# Hides live voice calls, music, gallery, video, and voice-note recording
EXPO_PUBLIC_EXPERIMENTAL_FEATURES=false

# Realtime WebRTC Call Voxa (requires native/dev build — not Expo Go)
# KEEP false for public release
EXPO_PUBLIC_REALTIME_VOICE_ENABLED=false
# Optional override; defaults to {SUPABASE_URL}/functions/v1/create-realtime-session
EXPO_PUBLIC_REALTIME_SESSION_URL=

# Scheduled Companion Calls V1 (local notification “incoming call” alerts — not CallKit/PushKit)
# KEEP false for public release
EXPO_PUBLIC_SCHEDULED_CALLS_ENABLED=false

# Voice notes attached to chat (mic recording) — KEEP false for public release
EXPO_PUBLIC_VOICE_NOTES_ENABLED=false

# In-chat microphone / live mic chat — KEEP false for public release
# Spoken AI replies (TTS) do NOT use this flag
EXPO_PUBLIC_MICROPHONE_CHAT_ENABLED=false

# V1 launch: fully free — billing code stays dormant. Set false to re-enable paywall later.
EXPO_PUBLIC_FREE_LAUNCH_MODE=true

# RevenueCat — public SDK keys only (never secret keys in the client)
# Expected names (platform-specific):
#   EXPO_PUBLIC_REVENUECAT_IOS_API_KEY
#   EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY
# When absent in development, the app boots with free access and logs
# "Billing unavailable in this development build."
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=voxa_pro
EXPO_PUBLIC_REVENUECAT_OFFERING_ID=default
# App Store Connect / Play product IDs (must match RevenueCat packages)
EXPO_PUBLIC_REVENUECAT_PRODUCT_MONTHLY=voxa_pro_monthly
EXPO_PUBLIC_REVENUECAT_PRODUCT_ANNUAL=voxa_pro_annual
EXPO_PUBLIC_REVENUECAT_TEST_STORE=false

# Optional OpenAI model routing overrides (gateway / server preferred in production)
EXPO_PUBLIC_OPENAI_CHAT_MODEL=
EXPO_PUBLIC_OPENAI_PRO_MODEL=
EXPO_PUBLIC_OPENAI_STRUCTURED_MODEL=
EXPO_PUBLIC_OPENAI_CLASSIFIER_MODEL=
EXPO_PUBLIC_OPENAI_VISION_MODEL=
EXPO_PUBLIC_LETTER_MODEL=
EXPO_PUBLIC_OPENAI_SPORTS_MODEL=

# Weather — Open-Meteo by default (no API key). Optional secure proxy:
EXPO_PUBLIC_WEATHER_API_URL=
# Set to "mock" for deterministic test data only — never in production
EXPO_PUBLIC_WEATHER_PROVIDER=

# Public legal URLs (must be live HTTPS before App Store submission)
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://voxa.app/privacy
EXPO_PUBLIC_TERMS_OF_SERVICE_URL=https://voxa.app/terms
EXPO_PUBLIC_SUPPORT_EMAIL=support@voxa.app

# development | preview | production
EXPO_PUBLIC_APP_ENV=development
